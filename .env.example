# --- Database ---
DATABASE_URL=postgres://rm:rm@localhost:5432/readymix
TEST_DATABASE_URL=postgres://rm:rm@localhost:5432/readymix_test

# --- API ---
PORT=4000
NODE_ENV=development
# Origin the browser app is served from (used for CSRF origin checks and invitation links)
WEB_ORIGIN=http://localhost:5173
# Secure cookies: true behind HTTPS (default true when NODE_ENV=production)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=480
INVITE_TTL_HOURS=72

# --- Onboarding (both OFF by default) ---
# First-run setup: set a long random secret to enable POST /api/setup on an EMPTY database; leave empty to disable.
SETUP_TOKEN=
# Public tenant signup: keep false for internal deployments.
ALLOW_TENANT_SIGNUP=false

# --- PDF ---
# Path to a Chromium/Chrome binary used for PDF rendering (required for PDF generation)
CHROMIUM_PATH=/opt/pw-browsers/chromium

# --- Serving the built web app from the API (production) ---
WEB_DIST=
RATE_LIMIT_ENABLED=true
