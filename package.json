{
  "name": "ready-mix-pricing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @rm/api\" \"npm run dev -w @rm/web\"",
    "build": "npm run build -w @rm/web && npm run build -w @rm/api",
    "start": "npm run start -w @rm/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "npm run test -w @rm/engine",
    "test:api": "npm run test -w @rm/api",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "db:generate": "npm run db:generate -w @rm/api",
    "db:migrate": "npm run db:migrate -w @rm/api",
    "db:seed:demo": "npm run seed:demo -w @rm/api",
    "db:dev:start": "bash scripts/dev-db.sh start"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}
